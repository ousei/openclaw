{
  "meta": {
    "lastTouchedVersion": "2026.2.3-1",
    "lastTouchedAt": "2026-02-20T15:26:49.300Z"
  },
  "env": {
    "OPENAI_API_KEY": "<从 .env 或环境变量读取>",
    "GEMINI_API_KEY": "<从 .env 或环境变量读取>",
    "TZ": "Asia/Tokyo"
  },
  "browser": { "attachOnly": true },
  "agents": {
    "defaults": {
      "model": { "primary": "ollama/qwen3-coder:480b-cloud", "fallbacks": ["ollama/gpt-oss:120b-cloud", "ollama/glm-5:cloud"] },
      "workspace": "C:\\Users\\<用户名>\\.openclaw\\workspace"
    },
    "list": [
      { "id": "main", "default": true, "workspace": "C:\\Users\\<用户名>\\.openclaw\\workspace" },
      { "id": "wa", "workspace": "C:\\Users\\<用户名>\\.openclaw\\workspace", "model": "ollama/qwen3-coder:480b-cloud" }
    ]
  },
  "bindings": [{ "agentId": "wa", "match": { "channel": "whatsapp" } }],
  "channels": {
    "whatsapp": {
      "dmPolicy": "allowlist",
      "selfChatMode": true,
      "allowFrom": ["+81XXXXXXXXXX"],
      "groupPolicy": "allowlist",
      "dmHistoryLimit": 20
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": { "mode": "token", "token": "<运行 openclaw onboard 生成>" }
  },
  "plugins": { "entries": { "whatsapp": { "enabled": true } } }
}
